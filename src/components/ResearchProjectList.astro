---
import type { ResearchProject } from '../data/site';
import ResearchEntry from './ResearchEntry.astro';

interface Props {
  projects: ResearchProject[];
  variant?: 'home' | 'research' | 'cv';
}

const { projects, variant = 'research' } = Astro.props as Props;
---

<ol class:list={['project-list', `project-list--${variant}`] }>
  {projects.map((project) => (
    <ResearchEntry project={project} variant={variant} />
  ))}
</ol>
