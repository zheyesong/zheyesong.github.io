---
interface Field { id: string; catalogueId: string; title: string; }
interface Props { fields: Field[]; }
const { fields } = Astro.props as Props;
---

<ul class="research-fields" aria-label="Research directions">
  {fields.map((field) => (
    <li>
      <a href={`/research/#${field.id}`} data-field-id={field.id}>{field.title}</a>
    </li>
  ))}
</ul>
