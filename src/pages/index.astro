---
import { getCollection } from 'astro:content';
import KineticHead from '../components/KineticHead.astro';
import ResearchFieldMap from '../components/ResearchFieldMap.astro';
import ResearchProjectList from '../components/ResearchProjectList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingPreview from '../components/WritingPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredResearchProjects, profile, site, websiteEducation } from '../data/site';
import { orderResearchEntries } from '../utils/research';
import '../styles/home.css';

const research = orderResearchEntries(await getCollection('research'))
  .filter((entry) => entry.data.featured);

const recentWriting = (await getCollection('writing'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2);
---

<BaseLayout>
  <section class="hero page-shell" aria-labelledby="page-title">
    <div class="hero__art">
      <KineticHead />
    </div>
    <div class="hero__content">
      <h1 id="page-title">{profile.name}</h1>
      <nav class="hero__links" aria-label="Profile links">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href="/cv/">CV</a>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <div class="hero__statement">
        <p>{profile.statement}</p>
      </div>
    </div>
  </section>

  <div class="home-content page-shell">
    <section class="margin-section content-section" aria-labelledby="research-heading">
      <SectionHeading variant="margin" index="01">
        <span id="research-heading">Research Interests</span>
      </SectionHeading>
      <div class="section-body">
      <ResearchFieldMap fields={research.map((entry) => ({
        id: entry.id,
        catalogueId: entry.data.catalogueId,
        title: entry.data.title,
      }))} />
      </div>
    </section>

    <section class="margin-section content-section content-section--research" aria-labelledby="work-heading">
      <SectionHeading variant="margin" index="02">
        <span id="work-heading">Selected Research</span>
      </SectionHeading>
      <div class="section-body">
      <ResearchProjectList projects={featuredResearchProjects} variant="home" />
      </div>
    </section>

    {recentWriting.length > 0 && (
      <section class="margin-section content-section content-section--writing" aria-labelledby="writing-heading">
        <SectionHeading variant="margin" index="03">
          <span id="writing-heading">Recent Writing</span>
        </SectionHeading>
      <div class="section-body">
        <WritingPreview entries={recentWriting} />
        </div>
    </section>
    )}

    <section class="margin-section content-section content-section--record" aria-labelledby="record-heading">
      <SectionHeading variant="margin" index="04">
        <span id="record-heading">Academic Record</span>
      </SectionHeading>
      <div class="section-body">
      <dl class="academic-record">
        {websiteEducation.map((entry) => (
          <div>
            <dt>{entry.institution}</dt>
            <dd>{entry.degree}</dd>
            <dd class="academic-record__period">{entry.period}</dd>
          </div>
        ))}
      </dl>
      </div>
    </section>

  </div>
</BaseLayout>
