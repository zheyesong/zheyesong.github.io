---
import { getCollection } from 'astro:content';
import ResearchProjectList from '../../components/ResearchProjectList.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { awards, cv, profile, researchProjects, site, technicalSkills, websiteEducation } from '../../data/site';
import { orderResearchEntries } from '../../utils/research';
import '../../styles/cv.css';

const research = orderResearchEntries(await getCollection('research'));
---

<BaseLayout
  title="CV | Zheye Song"
  description="Academic profile and research interests of Zheye Song."
>
  <article class="page-shell interior-page cv-page">
    <header class="interior-page__header cv-page__header">
      <div>
        <p class="page-folio">Folio 04</p>
        <h1>Curriculum Vitae</h1>
        <p>{profile.role}, {profile.institution}</p>
      </div>
      <div class="cv-page__contact">
        <a class="cv-page__download" href={cv.pdfHref} download>
          <span data-download-icon aria-hidden="true"></span>
          <span>Download PDF</span>
        </a>
        <div class="cv-page__contact-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
        </div>
        <p>Updated {cv.updated}</p>
      </div>
    </header>

    <section class="cv-section">
      <SectionHeading index="01">Education</SectionHeading>
      {websiteEducation.map((entry) => (
        <div class="cv-entry">
          <div class="cv-entry__meta">
            <p class="catalogue-index">{entry.catalogueId}</p>
            <p>{entry.period}</p>
            {entry.score && <p>{entry.score}</p>}
          </div>
          <div>
            <h3>{entry.institution}</h3>
            <p>{entry.degree}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="cv-section">
      <SectionHeading index="02">Research Interests</SectionHeading>
      <ul class="plain-list">
        {research.map((interest) => (
          <li>
            <span class="catalogue-index">{interest.data.catalogueId}</span>
            <span>{interest.data.title}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-section">
      <SectionHeading index="03">Research Projects</SectionHeading>
      <ResearchProjectList projects={researchProjects} variant="cv" />
    </section>

    <section class="cv-section">
      <SectionHeading index="04">Technical Skills</SectionHeading>
      <p>Programming: {technicalSkills.join(', ')}</p>
    </section>

    <section class="cv-section">
      <SectionHeading index="05">Honors and Awards</SectionHeading>
      {awards.map((award) => (
        <div class="cv-entry">
          <div class="cv-entry__meta">
            <p class="catalogue-index">{award.catalogueId}</p>
            <p>{award.year}</p>
          </div>
          <div>
            <h3>{award.title}</h3>
            <p>{award.institution}</p>
          </div>
        </div>
      ))}
    </section>
  </article>
</BaseLayout>

<script>
  import { createElement, Download } from 'lucide';

  document.querySelectorAll<HTMLElement>('[data-download-icon]').forEach((container) => {
    container.replaceChildren(createElement(Download, {
      width: 16,
      height: 16,
      strokeWidth: 1.6,
      'aria-hidden': 'true',
    }));
  });
</script>
